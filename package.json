{
  "name": "@hanzo/network-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.12.1",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-warnings' vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "node_modules/tsgo/bin/tsc --noEmit --incremental false -p tsconfig.app.json && node_modules/tsgo/bin/tsc --noEmit --incremental false -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "links": "playwright test --grep @network"
  },
  "dependencies": {
    "@hanzo/event": "0.3.66",
    "@hanzo/font": "1.11.0",
    "@hanzo/logo": "1.0.26",
    "@hanzo/tokens": "1.1.3",
    "lucide-react": "0.462.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "9.24.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.4",
    "@types/node": "22.14.1",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react-swc": "3.9.0",
    "eslint": "9.24.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "15.15.0",
    "tailwindcss": "4.1.4",
    "tsgo": "npm:typescript@7.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.30.1",
    "vite": "5.4.18",
    "vitest": "2.1.9"
  }
}
